# $OPENRIG_HOME/state/dsh/<member>@<rig>/seat.env, read by scripts/seat-up.sh.
# Plain KEY=VALUE lines; the file is read as data, never sourced. The last line
# for a key wins, and DSH_SEAT_<KEY> in the environment overrides it.

# Required: the Node the runner and dsh run on, by absolute path.
NODE=/absolute/path/to/node-v24/bin/node

# A seat whose work needs a specific JDK pins it here (exported, bin/ first on PATH).
JAVA_HOME=/opt/homebrew/opt/openjdk@21

# Per-seat homes for tools that would otherwise write under the real HOME, inside
# the seat's private TMPDIR, which the dsh workspace-write sandbox can write.
ENV_LUCLI_HOME={seat_tmp}/lucli-home
ENV_WHEELS_HOME={seat_tmp}/wheels-home
# LuCLI also resolves paths from Java's user.home, which LUCLI_HOME doesn't cover.
# The JVM notes this on stderr ("Picked up JAVA_TOOL_OPTIONS: ..."), so it shows in captured output.
ENV_JAVA_TOOL_OPTIONS=-Duser.home={seat_tmp}/java-home

# The raw LuCLI runtime, not the Homebrew `wheels` wrapper: the wrapper copies the
# module into $HOME/.wheels and resets LUCLI_HOME, so the Wheels test scripts refuse
# it when LUCLI_HOME/WHEELS_HOME are overridden. Use the stable opt/ path of
# whichever formula is installed (wheels or wheels-be).
ENV_LUCLI_BIN=/opt/homebrew/opt/wheels-be/libexec/wheels

# POSTURE=floor   (the only value seat-up.sh accepts)
# MODEL=deepseek/deepseek-chat
# INITIAL_PROMPT=off
