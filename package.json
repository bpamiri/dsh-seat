{
  "name": "dsh-seat",
  "version": "0.3.0",
  "description": "A dsh (DeepSeek Harness) runner preset for OpenRig's runner contract",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpamiri/dsh-seat.git"
  },
  "bin": {
    "dsh-seat": "bin/dsh-seat",
    "dsh-seat-adopt": "src/dsh-seat.mjs"
  },
  "exports": {
    ".": "./src/dsh-seat.mjs",
    "./acp": "./src/acp.mjs"
  },
  "files": [
    "bin",
    "preset",
    "src",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test 'test/*.test.mjs'",
    "probe": "node probes/probe-acp.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
