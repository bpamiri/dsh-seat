#!/usr/bin/env node
// SPDX-License-Identifier: Apache-2.0
// dsh-seat — an OpenRig runner preset for DeepSeek Harness (dsh) over ACP v1.
//
// Implements OpenRig's draft harness/runner contract (current through 0.7.9):
//   * starts dsh --profile acp on stdio and speaks newline-delimited JSON-RPC;
//   * writes the launch record after session/new (or a resume) is answered;
//   * reports turn boundaries, a working beat, permissions and exit;
//   * one submitted pane block = one session/prompt, byte for byte;
//   * routes permissions to OpenRig's answered path (person or permit; --deny
//     keeps the old refuse-and-hold posture);
//   * never starts a new conversation on a resume.
//
// Dependency-free: node builtins only. Usage:
//   dsh-seat [--agent-command 'dsh --profile acp'] [--name dsh]
// The agent command defaults to `dsh --profile acp`.

import { spawn } from "node:child_process";
import { existsSync, mkdirSync, readFileSync, realpathSync, renameSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { buildAgentEnv } from "../src/env.mjs";
import { prepareDshHome } from "../src/home.mjs";
import { resolveModelChoice } from "../src/model.mjs";
import { createPermissionTransport, selectPermitOption } from "../src/permission.mjs";

const VERSION = "0.3.0";
const DSH_VERSION = "0.2.1-rc.2";
const PROTOCOL_VERSION = 1;
// Message/thought chunks are throttled to one active post per 10 s per turn
// (OpenRig reads working stale after 15 s); every tool call posts unthrottled.
// The idle heartbeat is the contract's 60 s Stop/idle_heartbeat.
const CHUNK_POST_THROTTLE_MS = 10_000;
const IDLE_HEARTBEAT_MS = 60_000;
const IDLE_LIVENESS_SECONDS = 60;
// Working beat (§4, from 0.7.9): one beat counts as working for 15 s; beat
// every 5 s so a long quiet turn never ages out. Must be < liveness / 2.
const WORKING_BEAT_MS = 5_000;
const WORKING_LIVENESS_SECONDS = 15;
const OPENRIG = {
  url: env("OPENRIG_URL"),
  port: env("OPENRIG_PORT"),
  host: env("OPENRIG_HOST") || "127.0.0.1",
  token: env("OPENRIG_ACTIVITY_HOOK_TOKEN"),
  home: env("OPENRIG_HOME"),
  session: env("OPENRIG_SESSION_NAME") || "",
  nodeId: env("OPENRIG_NODE_ID") || "",
  runtime: env("OPENRIG_RUNTIME") || "dsh",
  generation: env("OPENRIG_OCCUPANT_GENERATION") || "",
  record: env("OPENRIG_LAUNCH_RESULT"),
  attempt: env("OPENRIG_LAUNCH_ATTEMPT") || "",
  resumeRef: env("OPENRIG_RESUME_REF"),
  firstInput: env("OPENRIG_FIRST_INPUT"),
  model: env("OPENRIG_MODEL"),
};
const argv = process.argv.slice(2);
const argValue = (name, fallback = null) => {
  const i = argv.indexOf(name);
  return i >= 0 && i + 1 < argv.length ? argv[i + 1] : fallback;
};
const agentCommand = argValue("--agent-command", "dsh --profile acp");
const presetName = argValue("--name", OPENRIG.runtime);
const requireResumeFlag = argv.includes("--require-resume");
// Section 7's default is permit (a person answers, or no one can be asked); the
// old refusal posture is an explicit opt-in.
const denyPermissions = argv.includes("--deny");

// DSH_SEAT_REQUIRE_RESUME is strict: exactly "1" turns it on, unset/empty/"0"
// leaves it off, and any other value is a configuration error (never guessed).
function requireResumeSetting() {
  const raw = process.env.DSH_SEAT_REQUIRE_RESUME;
  if (raw !== undefined && raw !== "" && raw !== "0" && raw !== "1") return { error: raw };
  if (requireResumeFlag) return { on: true, how: "--require-resume" };
  if (raw === "1") return { on: true, how: "DSH_SEAT_REQUIRE_RESUME=1" };
  return { on: false };
}

function env(name) {
  const value = process.env[name];
  return typeof value === "string" && value.trim() ? value.trim() : undefined;
}

// ── pane output ─────────────────────────────────────────────────────────────
// tmux keeps the pane alive for a person and for `rig capture`; stdout/stderr
// both land there. Never let a closed pane crash the runner with EPIPE.
const out = process.stdout;
for (const stream of [process.stdout, process.stderr]) stream.on("error", () => {});
let midLine = false;
function pane(text) {
  if (!text) return;
  out.write(text);
  midLine = !String(text).endsWith("\n");
}
function line(text = "") {
  if (midLine) { out.write("\n"); midLine = false; }
  out.write(`${text}\n`);
}
function warn(text) { line(`[dsh-seat] ${text}`); }

// ── launch record (contract §3) ─────────────────────────────────────────────
function writeLaunch(record) {
  if (!OPENRIG.record) return;
  try {
    mkdirSync(dirname(OPENRIG.record), { recursive: true });
    const tmp = `${OPENRIG.record}.tmp.${process.pid}`;
    writeFileSync(tmp, `${JSON.stringify(record)}\n`, { mode: 0o600 });
    renameSync(tmp, OPENRIG.record);
  } catch (error) {
    warn(`launch record not written: ${error.message}`);
  }
}
function producer() {
  return `dsh-seat ${VERSION}; dsh ${DSH_VERSION}; ACP ${PROTOCOL_VERSION}`;
}
function recordConversation(nativeRef) {
  writeLaunch({ format: 1, attempt: OPENRIG.attempt, harness: presetName, nativeRef, producer: producer() });
}
function recordMissing() {
  writeLaunch({ format: 1, attempt: OPENRIG.attempt, harness: presetName, error: "missing", producer: producer() });
}

// ── activity (contract §4) ──────────────────────────────────────────────────
// Posts are queued: each one is sent after the previous, in order, and never
// awaited by the agent/turn path. A refused or failed post records nothing.
let sequence = 0;
let postChain = Promise.resolve();
let pendingPosts = 0;
let endpoint = null;
function resolveEndpoint() {
  if (OPENRIG.url) return { base: OPENRIG.url.replace(/\/$/, ""), token: OPENRIG.token };
  if (OPENRIG.port) return { base: `http://${OPENRIG.host}:${OPENRIG.port}`, token: OPENRIG.token };
  if (OPENRIG.home) {
    try {
      const file = JSON.parse(readFileSync(join(OPENRIG.home, "activity-endpoint.json"), "utf8"));
      const base = file.url ?? file.baseUrl;
      if (base) return { base: String(base).replace(/\/$/, ""), token: file.token ?? OPENRIG.token };
    } catch { /* no endpoint file */ }
  }
  return null;
}
endpoint = resolveEndpoint();
function post(hookEvent, subtype, extra = {}) {
  if (!endpoint?.token) return postChain;
  const body = {
    sessionName: OPENRIG.session,
    nodeId: OPENRIG.nodeId,
    runtime: presetName,
    generation: OPENRIG.generation,
    sequence: ++sequence,
    occurredAt: new Date().toISOString(),
    hookEvent,
    subtype,
    ...extra,
  };
  pendingPosts++;
  postChain = postChain.then(async () => {
    try {
      await fetch(`${endpoint.base}/api/activity/hooks`, {
        method: "POST",
        headers: { "content-type": "application/json", authorization: `Bearer ${endpoint.token}` },
        body: JSON.stringify(body),
        signal: AbortSignal.timeout(1500),
      });
    } catch { /* never hold the runner on a post */ }
    finally { pendingPosts--; }
  });
  return postChain;
}
async function drainPosts(ms = 2000) {
  let timer;
  await Promise.race([
    postChain.catch(() => {}),
    new Promise((resolve) => { timer = setTimeout(resolve, ms); }),
  ]);
  clearTimeout(timer);
}

// ── activity reporting: turn, attention, working posts, idle heartbeat ──────
// Exported for the contract tests, which drive it in-process with fake timers
// and an injected post sink (no port, no sleeping). The runner uses one
// instance; `post` is the queue above, `enabled` says an endpoint exists.
export function createActivityReporter({
  post,
  now = () => Date.now(),
  hasPendingPost = () => false,
  enabled = () => true,
  throttleMs = CHUNK_POST_THROTTLE_MS,
  beatMs = IDLE_HEARTBEAT_MS,
  livenessSeconds = IDLE_LIVENESS_SECONDS,
  workingBeatMs = WORKING_BEAT_MS,
  workingLivenessSeconds = WORKING_LIVENESS_SECONDS,
}) {
  let turn = null;          // { turnId, cancelSent, lastChunkPostAt }
  let attention = false;
  let beatTimer = null;
  let workingTimer = null;
  let dead = false;         // the agent exited or the runner is shutting down

  function stopBeat() {
    if (beatTimer) { clearInterval(beatTimer); beatTimer = null; }
  }
  function stopWorking() {
    if (workingTimer) { clearInterval(workingTimer); workingTimer = null; }
  }
  function startWorking() {
    if (workingTimer || dead || !turn || attention || !enabled()) return;
    workingTimer = setInterval(() => {
      // The turn's Stop, a permission ask, attention or an exit retires the
      // working beat; a post still in flight makes this beat skip.
      if (dead || !turn || attention) { stopWorking(); return; }
      if (hasPendingPost()) return;
      post("active", "liveness", { turnId: turn.turnId, livenessSeconds: workingLivenessSeconds });
    }, workingBeatMs);
    workingTimer.unref?.();
  }
  function startBeat() {
    if (beatTimer || dead || turn || attention || !enabled()) return;
    beatTimer = setInterval(() => {
      // A turn, attention, an exit or a shutdown retires the beat; a post still
      // in flight makes this beat skip rather than queue behind it.
      if (dead || turn || attention) { stopBeat(); return; }
      if (hasPendingPost()) return;
      post("Stop", "idle_heartbeat", { livenessSeconds });
    }, beatMs);
    beatTimer.unref?.();
  }

  return {
    get turn() { return turn; },
    get attentionHeld() { return attention; },
    get beatArmed() { return beatTimer !== null; },
    get beatHandle() { return beatTimer; },
    get workingBeatArmed() { return workingTimer !== null; },
    get workingBeatHandle() { return workingTimer; },
    beginTurn(turnId) {
      stopBeat();
      stopWorking();
      attention = false;
      turn = { turnId, cancelSent: false, lastChunkPostAt: -Infinity };
      post("UserPromptSubmit", "accepted", { turnId });
      startWorking();
      return turn;
    },
    // Every real tool call is working evidence and posts unthrottled: a tool
    // call is rare and meaningful, and it must never be dropped behind a
    // chunk's window (nor consume or reset that window). Still only for an
    // open turn, with no attention held and no exit/shutdown.
    toolCall(toolKind) {
      if (!turn || attention || dead) return false;
      post("PreToolUse", toolKind, { turnId: turn.turnId });
      return true;
    },
    // Message and thought chunks are frequent: at most one active post per
    // throttleMs per turn so a burst of chunks cannot flood the endpoint. An
    // exit or shutdown also suppresses it: shutdown() leaves the turn open, so
    // a chunk already buffered then must not post.
    messageChunk() {
      if (!turn || attention || dead) return false;
      const at = now();
      if (at - turn.lastChunkPostAt < throttleMs) return false;
      turn.lastChunkPostAt = at;
      post("active", "agent_message", { turnId: turn.turnId });
      return true;
    },
    // Refuse-and-hold (the seat's --deny, denied_by_seat, options_unsupported,
    // or a local no-allow refusal).
    permission() {
      attention = true;
      stopBeat();
      stopWorking();
      post("Notification", "permission_prompt", turn ? { turnId: turn.turnId } : {});
    },
    // A submit is in flight: stop the beat without deciding attention yet, so a
    // permit-at-submit can resume it at once and an ask-created can hold it.
    pauseWorking() { stopWorking(); },
    // OpenRig created an ask and recorded permission_prompt itself; hold
    // attention without posting one, and keep the working beat stopped.
    awaitingPerson() {
      stopWorking();
      stopBeat();
      attention = true;
    },
    // A permit/answer reached the agent: clear attention, post the 0.7.9
    // boundary before any beat, and resume the working beat for the same turn.
    permissionResolved(askId) {
      attention = false;
      if (turn) post("active", "permission_resolved", { turnId: turn.turnId, askId });
      startWorking();
    },
    // A refused/withdrawn/stale read or a permit-at-submit with no ask: clear
    // attention (nobody waits) and resume the beat if the turn continues.
    permissionSettled() {
      attention = false;
      startWorking();
    },
    // The turn ended on the agent's own stop reason (end_turn, cancelled, …).
    // Never a Stop while attention is held: OpenRig reads any non-exit Stop as
    // idle and would clear needs-input.
    endTurn(stopReason) {
      if (!turn) return null;
      const ended = turn;
      stopWorking();
      turn = null;
      if (!attention) post("Stop", stopReason, { turnId: ended.turnId, livenessSeconds });
      return ended;
    },
    // The prompt failed before giving a stop reason: no Stop, the runtime_error
    // notice carries the turn instead.
    abandonTurn() {
      const ended = turn;
      turn = null;
      return ended;
    },
    idle() { startBeat(); },
    agentExited() { dead = true; stopBeat(); stopWorking(); },
    shutdown() { dead = true; stopBeat(); stopWorking(); },
  };
}

// One reporter for the runner's lifetime. `endpoint`/`pendingPosts` are the
// post queue's; `enabled()` keeps the beat off when no endpoint is configured.
const activity = createActivityReporter({
  post,
  hasPendingPost: () => pendingPosts > 0,
  enabled: () => Boolean(endpoint?.token),
});

// ── ACP client ──────────────────────────────────────────────────────────────
let child = null;
let childExited = false;
let childExit = { code: null, signal: null };
let shuttingDown = false;
let writeBroken = false;
const pending = new Map();
let nextRequestId = 1;

function send(message) {
  if (!child?.stdin?.writable || writeBroken) return false;
  try {
    child.stdin.write(`${JSON.stringify(message)}\n`);
    return true;
  } catch {
    writeBroken = true;
    return false;
  }
}
function request(method, params, { timeoutMs = 0 } = {}) {
  const id = nextRequestId++;
  return new Promise((resolve, reject) => {
    if (childExited) { reject(new AcpError(`${method}: the agent is not running`, { code: null, method })); return; }
    const timer = timeoutMs > 0 ? setTimeout(() => {
      if (!pending.has(id)) return;
      pending.delete(id);
      reject(new AcpError(`${method}: timed out after ${timeoutMs}ms`, { code: null, method }));
    }, timeoutMs) : null;
    pending.set(id, { resolve, reject, method, timer });
    if (!send({ jsonrpc: "2.0", id, method, params })) {
      pending.delete(id);
      if (timer) clearTimeout(timer);
      reject(new AcpError(`${method}: could not write to the agent`, { code: null, method }));
    }
  });
}
class AcpError extends Error {
  constructor(message, { code = null, method = null } = {}) {
    super(message);
    this.name = "AcpError";
    this.code = code;
    this.method = method;
  }
}

function startAgent(dshHome) {
  child = spawn(agentCommand, {
    shell: true,
    detached: process.platform !== "win32",
    stdio: ["pipe", "pipe", "pipe"],
    // Baseline + OpenRig identity/routing + dsh's telemetry choice, the seat's
    // own DSH_HOME, and only the declared provider's key. Never the hook token
    // or the runner-only launch/attempt/resume variables.
    env: buildAgentEnv(process.env, { model: OPENRIG.model, dshHome }),
  });
  child.on("error", (error) => {
    warn(`could not start the agent: ${error.message}`);
    void stop(1, "spawn-error");
  });
  child.on("exit", (code, signal) => {
    childExited = true;
    childExit = { code, signal };
    for (const [, entry] of pending) {
      if (entry.timer) clearTimeout(entry.timer);
      entry.reject(new AcpError(`agent exited (code=${code} signal=${signal})`, { method: entry.method }));
    }
    pending.clear();
    // No idle heartbeat once the agent is gone; the exit Stop below is final.
    activity.agentExited();
    if (!shuttingDown) {
      void (async () => {
        await withdrawAllAsks("exited");
        warn(`agent exited (code=${code} signal=${signal})`);
        post("Stop", `${presetName}_exited`);
        await drainPosts();
        await stop(code === 0 ? 0 : 1, "agent-exit");
      })();
    }
  });
  let buffer = "";
  child.stdout.setEncoding("utf8");
  child.stdout.on("data", (chunk) => {
    buffer += chunk;
    let at;
    while ((at = buffer.indexOf("\n")) >= 0) {
      const raw = buffer.slice(0, at).replace(/\r$/, "");
      buffer = buffer.slice(at + 1);
      if (raw.trim()) handleAgentLine(raw);
    }
  });
  child.stderr.setEncoding("utf8");
  child.stderr.on("data", (chunk) => {
    for (const text of String(chunk).split("\n")) if (text.trim()) warn(text.trim());
  });
}

function handleAgentLine(raw) {
  let msg;
  try { msg = JSON.parse(raw); } catch {
    warn(`agent wrote a non-JSON line: ${raw.slice(0, 160)}`);
    return;
  }
  if (msg.id !== undefined && msg.method === undefined) {
    const entry = pending.get(msg.id);
    if (!entry) return;
    pending.delete(msg.id);
    if (entry.timer) clearTimeout(entry.timer);
    if (msg.error) entry.reject(new AcpError(msg.error.message ?? "ACP error", { code: msg.error.code ?? null, method: entry.method }));
    else entry.resolve(msg.result ?? null);
    return;
  }
  if (msg.method && msg.id !== undefined) { handleAgentRequest(msg); return; }
  if (msg.method) { handleAgentNotification(msg); return; }
}

function handleAgentRequest(msg) {
  if (msg.method === "session/request_permission") {
    void handlePermissionRequest(msg);
    return;
  }
  send({ jsonrpc: "2.0", id: msg.id, error: { code: -32601, message: `Method not found: ${msg.method}` } });
}

// ── answered permissions (contract §7) ──────────────────────────────────────
// Real dsh can have more than one approval outstanding (parallel tool calls), so
// asks are tracked in a Map keyed by the agent's request id. Attention and the
// working beat are aggregate state: no beat while any ask is open, and an ask's
// resolution only clears attention when it was the last one (and no refusal is
// holding attention).
const openAsks = new Map();
let refusedHeld = false;
let permissionTransport = null;
function permissions() {
  if (!endpoint?.token) return null;
  permissionTransport ??= createPermissionTransport({ base: endpoint.base, token: endpoint.token });
  return permissionTransport;
}
const askKey = (requestId) => String(requestId);
async function submitPermission(body) {
  const transport = permissions();
  if (!transport) return { kind: "permit", optionId: null, reason: "no OpenRig endpoint" };
  try { return await transport.submit(body); }
  catch { return { kind: "permit", optionId: null, reason: "OpenRig unreachable" }; }
}
async function readPermission(ask, turn) {
  const transport = permissions();
  if (!transport) return { kind: "permit", optionId: null, reason: "no OpenRig endpoint" };
  const controller = new AbortController();
  const onDone = () => controller.abort();
  turn.waiters.add(onDone);
  try {
    while (!turn.finished) {
      try {
        const classified = await transport.readOnce(ask.askId, { signal: controller.signal });
        if (classified.kind !== "pending") return classified;
      } catch (error) {
        if (turn.finished) return { kind: "cancelled", reason: turn.cancelSent ? "turn_cancelled" : "turn_ended" };
        // A bounded read that timed out (or another transport failure) is "no
        // answer": nobody can be asked, so permit, never hold the turn.
        return { kind: "permit", optionId: null, reason: error?.name === "PermissionTimeoutError" ? "read timed out" : "read got no answer" };
      }
    }
    return { kind: "cancelled", reason: turn.cancelSent ? "turn_cancelled" : "turn_ended" };
  } finally {
    turn.waiters.delete(onDone);
  }
}
async function withdrawPermission(askId, reason) {
  try { await permissions()?.withdraw(askId, reason); } catch { /* best effort */ }
}
function answerPermission(ask, result) {
  if (ask.answered) return;
  ask.answered = true;
  if (childExited || shuttingDown) return;
  send({ jsonrpc: "2.0", id: ask.requestId, result });
}
// Only asks still waiting on a person hold attention; a read that already
// delivered a permit stays in the map so its ask is withdrawn at turn end, but
// it no longer counts as attention.
function hasPendingAsk() {
  for (const ask of openAsks.values()) if (!ask.answered && !ask.held) return true;
  return false;
}
// Remove one ask and update the aggregate attention/beat state only when nothing
// else is asking (and no refused ask is holding attention). `preserve` keeps an
// already-answered ask in the map for the turn-end withdraw.
function settleAsk(ask, { resolved = false, preserve = false } = {}) {
  if (preserve) ask.answered = true;
  else openAsks.delete(askKey(ask.requestId));
  if (hasPendingAsk() || refusedHeld) return;
  if (resolved && ask.askId) activity.permissionResolved(ask.askId);
  else activity.permissionSettled();
}
async function withdrawAllAsks(reason) {
  const asks = [...openAsks.values()];
  openAsks.clear();
  const pendingWithdraws = [];
  for (const ask of asks) {
    if (!ask.answered) answerPermission(ask, { outcome: { outcome: "cancelled" } });
    if (ask.askId && !ask.withdrawn) {
      ask.withdrawn = true;
      pendingWithdraws.push(withdrawPermission(ask.askId, reason));
    }
  }
  // Clear the aggregate attention before the withdraw round-trips, so a turn
  // settling meanwhile can post its Stop.
  if (asks.length > 0 && !refusedHeld) activity.permissionSettled();
  await Promise.all(pendingWithdraws);
  return asks.length > 0;
}
function queueSaid(said) {
  if (typeof said !== "string" || !said.trim()) return;
  // Section 7's optional 0.7.9 behaviour: a person's own words reach the agent
  // as an ordinary prompt, after this turn and behind anything already queued.
  queue.push(said);
}
async function handlePermissionRequest(msg) {
  const key = askKey(msg.id);
  if (openAsks.has(key)) return; // the same agent request id is already live
  const tool = msg.params?.toolCall ?? {};
  const title = tool.title ?? tool.toolCallId ?? "a tool";
  const options = Array.isArray(msg.params?.options) ? msg.params.options : [];
  const turn = activity.turn;
  const ask = { requestId: msg.id, askId: null, answered: false, withdrawn: false, held: false, turn };
  openAsks.set(key, ask);
  const refuseHold = (why) => {
    line(`[permission] ${title} — refused (${why})`);
    ask.held = true;
    refusedHeld = true;
    openAsks.delete(key);
    activity.permission();
    answerPermission(ask, { outcome: { outcome: "cancelled" } });
  };
  if (!turn) { openAsks.delete(key); answerPermission(ask, { outcome: { outcome: "cancelled" } }); return; }
  if (denyPermissions) { refuseHold("--deny"); return; }

  activity.pauseWorking();
  const submitted = await submitPermission({
    sessionName: OPENRIG.session,
    nodeId: OPENRIG.nodeId,
    generation: OPENRIG.generation,
    nativeRef: sessionId,
    turnId: turn.turnId,
    requestId: msg.id,
    toolCall: { title, kind: typeof tool.kind === "string" && tool.kind ? tool.kind : "tool" },
    options: options.map((option) => ({
      optionId: option?.optionId,
      name: option?.name ?? option?.optionId,
      kind: option?.kind,
    })),
    occurredAt: new Date().toISOString(),
  });
  if (turn.finished) {
    openAsks.delete(key);
    if (ask.askId) { ask.withdrawn = true; await withdrawPermission(ask.askId, turn.cancelSent ? "turn_cancelled" : "turn_ended"); }
    answerPermission(ask, { outcome: { outcome: "cancelled" } });
    return;
  }

  if (submitted.kind === "refuse-hold") { refuseHold(submitted.reason); return; }
  if (submitted.kind === "cancel") {
    answerPermission(ask, { outcome: { outcome: "cancelled" } });
    settleAsk(ask);
    return;
  }
  if (submitted.kind === "permit") {
    const optionId = submitted.optionId ?? selectPermitOption(options);
    if (!optionId) { refuseHold("no allow option"); return; }
    answerPermission(ask, { outcome: { outcome: "selected", optionId } });
    settleAsk(ask, { resolved: false });
    return;
  }

  // A person is asked: hold attention (OpenRig posted permission_prompt), read
  // until they answer or the turn ends, and deliver once.
  ask.askId = submitted.askId;
  activity.awaitingPerson();
  const read = await readPermission(ask, turn);
  if (turn.finished || !openAsks.has(key)) return;
  if (read.kind === "selected") {
    answerPermission(ask, { outcome: { outcome: "selected", optionId: read.optionId } });
    // Keep the answered ask until turn end: the contract withdraws every open
    // request when the turn ends, and a later answer can't be delivered.
    settleAsk(ask, { resolved: true, preserve: true });
    queueSaid(read.said);
    return;
  }
  if (read.kind === "permit") {
    const optionId = read.optionId ?? selectPermitOption(options);
    if (!optionId) { refuseHold("no allow option"); return; }
    answerPermission(ask, { outcome: { outcome: "selected", optionId } });
    // The ask may still be open on OpenRig's side; keep it for the turn-end
    // withdraw while clearing attention for the permit already delivered.
    settleAsk(ask, { resolved: true, preserve: true });
    queueSaid(read.said);
    return;
  }
  if (read.kind === "refuse-hold") { refuseHold(read.reason); return; }
  // refused / withdrawn / stale / cancel: no person is still waiting on this one.
  if (read.reason === "withdrawn" || read.reason === "stale") ask.withdrawn = true;
  answerPermission(ask, { outcome: { outcome: "cancelled" } });
  settleAsk(ask);
  queueSaid(read.said);
}

function handleAgentNotification(msg) {
  if (msg.method !== "session/update") return;
  const update = msg.params?.update ?? {};
  const kind = update.sessionUpdate;
  if (kind === "agent_message_chunk") {
    const content = update.content;
    if (content?.type === "text" && typeof content.text === "string") pane(content.text);
    // A real message chunk is working evidence; the reporter throttles it and
    // suppresses it while attention is held. Pane output is untouched.
    activity.messageChunk();
  } else if (kind === "agent_thought_chunk") {
    const content = update.content;
    if (content?.type === "text" && typeof content.text === "string") pane(content.text);
    activity.messageChunk();
  } else if (kind === "tool_call" || kind === "tool_call_update") {
    const title = update.title ?? update.toolCallId ?? update.kind;
    if (title) line(`[tool] ${title}${update.status ? ` — ${update.status}` : ""}`);
    // Only the initial tool_call is a working post; tool_call_update is status
    // noise and stays pane-only (contract §4: PreToolUse/<tool kind>).
    if (kind === "tool_call") {
      const toolKind = typeof update.kind === "string" && update.kind ? update.kind : "tool";
      activity.toolCall(toolKind);
    }
  }
}

// ── input (contract §5) ─────────────────────────────────────────────────────
// Raw mode + bracketed paste. A whole paste (newlines included) plus the Enter
// that follows is one block. Only a block that is exactly "/abort", or Ctrl-C
// outside a paste, is control. Non-TTY input is read line by line.
let block = "";
let pasteBuffer = null;
let escapeBuffer = "";
// The open turn and permission attention live in `activity` (above): the
// reporter owns the turnId, the working-post throttle and the idle beat.
let promptQueued = false;
let turnCount = 0;
const queue = [];
// open permission asks are tracked in bin's answered-permissions section

function handleInputChunk(chunk) {
  for (const char of String(chunk)) {
    if (pasteBuffer !== null) {
      // Ctrl-C inside a paste is control too (listed in limits): abort the turn
      // and discard the paste rather than pasting the byte as text.
      if (char === "\x03") { pasteBuffer = null; block = ""; cancelTurn(); continue; }
      pasteBuffer += char;
      if (pasteBuffer.endsWith("\x1b[201~")) {
        block += pasteBuffer.slice(0, -6);
        pasteBuffer = null;
      }
      continue;
    }
    if (escapeBuffer) {
      escapeBuffer += char;
      if (escapeBuffer === "\x1b[200~") { pasteBuffer = ""; escapeBuffer = ""; continue; }
      if ("\x1b[200~".startsWith(escapeBuffer) || "\x1b[201~".startsWith(escapeBuffer)) continue;
      escapeBuffer = "";
      continue;
    }
    if (char === "\x1b") { escapeBuffer = "\x1b"; continue; }
    if (char === "\r" || char === "\n") { submitBlock(); continue; }
    if (char === "\x03") {
      if (pasteBuffer !== null) { pasteBuffer = null; block = ""; }
      cancelTurn();
      continue;
    }
    if (char === "\x7f" || char === "\b") { block = block.slice(0, -1); continue; }
    block += char;
  }
}

function submitBlock() {
  const value = block;
  block = "";
  if (!value.trim()) return;
  if (value === "/abort") { cancelTurn(); return; }
  if (!sessionId) { warn("no conversation is open yet — the prompt was not sent"); return; }
  queue.push(value);
  if (queue.length > 1 || activity.turn) {
    line(`[queued: ${queue.length}${activity.turn ? " · 1 running" : ""}]`);
  } else {
    void pump();
  }
}

function cancelTurn() {
  const turn = activity.turn;
  if (!sessionId || !turn) { line("[dsh-seat] cancel requested (no turn in flight)"); return; }
  if (turn.cancelSent) return;
  turn.cancelSent = true;
  send({ jsonrpc: "2.0", method: "session/cancel", params: { sessionId } });
  // An ask waiting on a person is withdrawn now: its answer unblocks the agent
  // so session/cancel can settle the turn, and no person is still waiting.
  void withdrawAllAsks("turn_cancelled");
  line("[dsh-seat] cancel requested");
}

async function pump() {
  if (promptQueued || !sessionId || shuttingDown) return;
  const text = queue.shift();
  if (text === undefined) return;
  promptQueued = true;
  refusedHeld = false;
  const turn = activity.beginTurn(String(++turnCount));
  turn.finished = false;
  turn.waiters = new Set();
  line(`you ▸ ${text.split("\n")[0].slice(0, 160)}${text.includes("\n") ? " …" : ""}`);
  let stopReason = "end_turn";
  let failed = false;
  try {
    const result = await request("session/prompt", { sessionId, prompt: [{ type: "text", text }] });
    stopReason = typeof result?.stopReason === "string" ? result.stopReason : "end_turn";
  } catch (error) {
    failed = true;
    if (!childExited && !shuttingDown) {
      warn(`prompt failed: ${error.message}`);
      post("Notification", "runtime_error", { turnId: turn.turnId });
    }
  } finally {
    // End the turn *after* any ask is withdrawn: a waiter can then settle the
    // cancelled turn as usual, while a refused-and-held permission keeps its
    // attention and suppresses the Stop.
    turn.finished = true;
    for (const waiter of turn.waiters) { try { waiter(); } catch { /* best effort */ } }
    turn.waiters.clear();
    await withdrawAllAsks(turn.cancelSent ? "turn_cancelled" : "turn_ended");
    if (failed) activity.abandonTurn(); else activity.endTurn(stopReason);
    promptQueued = false;
    // The next queued prompt arms a new turn (which stops the beat); an empty
    // queue lets the idle heartbeat start now that the turn has settled.
    if (!shuttingDown) { void pump(); activity.idle(); }
  }
}

// ── handshake and resume (contract §3, §8) ──────────────────────────────────
let sessionId = null;

async function openConversation() {
  const init = await request("initialize", {
    protocolVersion: PROTOCOL_VERSION,
    clientCapabilities: {},
    clientInfo: { name: "dsh-seat", version: VERSION },
  }, { timeoutMs: 30000 });
  if (init?.protocolVersion !== PROTOCOL_VERSION) {
    throw new Error(`the agent speaks ACP ${init?.protocolVersion ?? "unknown"}; this runner needs ACP ${PROTOCOL_VERSION}`);
  }
  if (OPENRIG.resumeRef) {
    line(`[dsh-seat] resuming ${OPENRIG.resumeRef} (asked by OpenRig)`);
    await reopen(OPENRIG.resumeRef);
  } else {
    line("[dsh-seat] new conversation (OpenRig passed no resume ref)");
    const result = await request("session/new", { cwd: process.cwd(), mcpServers: [] }, { timeoutMs: 30000 });
    sessionId = typeof result?.sessionId === "string" ? result.sessionId : "";
    if (!sessionId) throw new Error("session/new returned no session id");
    // Apply the model before the launch record: OpenRig may consider the seat
    // ready as soon as the record exists, so the declared model must already be
    // in effect (or reported as unappliable) by then.
    await applyModel(result?.configOptions);
    recordConversation(sessionId);
  }
}

async function reopen(ref) {
  const params = { sessionId: ref, cwd: process.cwd(), mcpServers: [] };
  let result;
  try {
    result = await request("session/resume", params, { timeoutMs: 30000 });
  } catch (error) {
    // ACP's loadSession is the alternative reopen method some agents advertise.
    // dsh 0.2.1-rc.2 advertises sessionCapabilities.resume only and answers
    // session/load with -32601; this fallback is for other ACP agents.
    if (error.code === -32601 || /method not found/i.test(error.message)) {
      result = await request("session/load", params, { timeoutMs: 30000 });
    } else if (isMissing(error)) {
      recordMissing();
      await drainPosts();
      await stop(0, "resume-missing");
      throw error;
    } else {
      warn(`resume failed: ${error.message}`);
      await drainPosts();
      await stop(1, "resume-failed");
      throw error;
    }
  }
  // dsh's session/resume does not re-report the id; an error-free reopen is the
  // contract's "same conversation reopened" and the requested ref is recorded.
  sessionId = ref;
  // A changed model on restore must apply too, from the resume's configOptions,
  // before the record makes the seat ready.
  await applyModel(result?.configOptions);
  recordConversation(ref);
}

function isMissing(error) {
  return error?.code === -32002
    // dsh 0.2.1-rc.2 says "session is not resumable: <id>" for an unknown id and
    // "session is already active: <id>" for a live one — only the former is its
    // own word that the conversation is gone.
    || /session not found|not found|no such session|unknown session|session is not resumable/i.test(String(error?.message ?? ""));
}

async function applyModel(configOptions) {
  if (!OPENRIG.model) return;
  const resolved = resolveModelChoice(configOptions, OPENRIG.model);
  if (!resolved.ok) {
    // Reported, never silently ignored: the pane says what was asked and what
    // dsh advertised; dsh's own default stays in effect.
    warn(`declared model ${OPENRIG.model} not applied: ${resolved.error}`);
    return;
  }
  try {
    await request("session/set_config_option", { sessionId, configId: "model", value: resolved.value }, { timeoutMs: 15000 });
    line(`[dsh-seat] model: ${resolved.label}`);
  } catch (error) {
    warn(`could not apply the declared model: ${error.message}`);
  }
}

function enqueueFirstInput() {
  if (!OPENRIG.firstInput) return;
  try {
    const text = readFileSync(OPENRIG.firstInput, "utf8");
    if (text.length > 0 && sessionId) { queue.push(text); void pump(); }
  } catch (error) {
    warn(`could not read OPENRIG_FIRST_INPUT: ${error.message}`);
  }
}

// ── lifecycle ───────────────────────────────────────────────────────────────
let ttyRestored = false;
function restoreTty() {
  if (ttyRestored) return;
  ttyRestored = true;
  try { process.stdin.setRawMode?.(false); } catch { /* not a tty */ }
  try { out.write("\x1b[?2004l"); } catch { /* pane gone */ }
}
function killAgent(signal) {
  if (!child?.pid) return;
  try { process.kill(-child.pid, signal); } catch {
    try { child.kill(signal); } catch { /* already gone */ }
  }
}
async function stop(code, why) {
  if (shuttingDown) return;
  shuttingDown = true;
  await withdrawAllAsks("exited");
  activity.shutdown();
  restoreTty();
  warn(`shutting down (${why})`);
  killAgent("SIGTERM");
  const exited = new Promise((resolve) => {
    if (childExited) { resolve(); return; }
    child?.once("exit", resolve);
  });
  await Promise.race([exited, new Promise((resolve) => setTimeout(resolve, 1200))]);
  killAgent("SIGKILL");
  await drainPosts();
  process.exit(code);
}

async function main() {
  // The resume requirement is a launch-time guard: refuse before any agent is
  // spawned, so a managed launch that must resume can never create a new
  // conversation. A fresh launch has no ref by design, so the flag is opt-in.
  const requireResume = requireResumeSetting();
  if (requireResume.error !== undefined) {
    line(`[dsh-seat] refusing to start: DSH_SEAT_REQUIRE_RESUME must be exactly 1 (on) or 0/empty (off), got ${JSON.stringify(requireResume.error)}; no conversation was created`);
    process.exitCode = 1;
    return;
  }
  if (requireResume.on && !OPENRIG.resumeRef) {
    line(`[dsh-seat] refusing to start: ${requireResume.how} is set but OpenRig passed no resume ref; no conversation was created`);
    writeLaunch({ format: 1, attempt: OPENRIG.attempt, harness: presetName, error: "resume_required", producer: producer() });
    process.exitCode = 1;
    return;
  }
  const prepared = prepareDshHome(process.env);
  if (!prepared.ok) {
    warn(prepared.error);
    process.exitCode = 1;
    return;
  }
  if (prepared.provisioned) {
    line(`[dsh-seat] DSH_HOME ${prepared.home}${prepared.sourceProfile ? " (copied the operator's acp profile; no credential file)" : " (new; no operator acp profile found)"}`);
  }
  startAgent(prepared.home);
  if (process.stdin.isTTY) {
    process.stdin.setRawMode(true);
    out.write("\x1b[?2004h");
  }
  process.stdin.setEncoding("utf8");
  if (process.stdin.isTTY) {
    process.stdin.on("data", handleInputChunk);
  } else {
    let buffer = "";
    process.stdin.on("data", (chunk) => {
      buffer += chunk;
      let at;
      while ((at = buffer.indexOf("\n")) >= 0) {
        const text = buffer.slice(0, at).replace(/\r$/, "");
        buffer = buffer.slice(at + 1);
        if (text.trim() && text !== "/abort") { queue.push(text); void pump(); }
        else if (text === "/abort") cancelTurn();
      }
    });
  }
  process.stdin.on("close", () => { if (!shuttingDown) void stop(0, "stdin-closed"); });
  process.on("SIGHUP", () => void stop(0, "hangup"));
  process.on("SIGTERM", () => void stop(0, "sigterm"));
  process.on("SIGINT", () => void stop(0, "sigint"));
  process.on("exit", () => killAgent("SIGKILL"));

  try {
    await openConversation();
    line(`[dsh-seat] ${presetName} ready · ACP ${PROTOCOL_VERSION}`);
    // The seat is idle until the first prompt: start the 60 s heartbeat. A
    // first prompt (or a queued one) immediately starts a turn and stops it.
    activity.idle();
    enqueueFirstInput();
  } catch (error) {
    if (!shuttingDown) {
      warn(`handshake failed: ${error.message}`);
      await stop(1, "handshake-failed");
    }
  }
}

// True only when this file is the process entrypoint. Both sides go through
// realpath: a symlinked install (`npm link` puts a symlink on PATH) or a
// /tmp -> /private/tmp alias resolves to the same file as import.meta.url,
// while importing the file for its exports must still not run main().
export function isEntrypoint(argv1, moduleUrl) {
  if (!argv1) return false;
  try {
    return realpathSync(argv1) === realpathSync(fileURLToPath(moduleUrl));
  } catch {
    return false;
  }
}

if (isEntrypoint(process.argv[1], import.meta.url)) void main();
