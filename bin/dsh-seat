#!/usr/bin/env node
// SPDX-License-Identifier: Apache-2.0
// dsh-seat — an OpenRig runner preset for DeepSeek Harness (dsh) over ACP v1.
//
// Implements the draft harness/runner contract (OpenRig 0.7.6):
//   * starts dsh --profile acp on stdio and speaks newline-delimited JSON-RPC;
//   * writes the launch record after session/new (or a resume) is answered;
//   * reports turn boundaries / permissions / exit to OpenRig's activity route;
//   * one submitted pane block = one session/prompt, byte for byte;
//   * refuses every permission request at once, and holds needs-input;
//   * never starts a new conversation on a resume.
//
// Dependency-free: node builtins only. Usage:
//   dsh-seat [--agent-command 'dsh --profile acp'] [--name dsh]
// The agent command defaults to `dsh --profile acp`.

import { spawn } from "node:child_process";
import { existsSync, mkdirSync, readFileSync, renameSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { buildAgentEnv } from "../src/env.mjs";
import { resolveModelChoice } from "../src/model.mjs";

const VERSION = "0.3.0";
const DSH_VERSION = "0.2.1-rc.2";
const PROTOCOL_VERSION = 1;
const OPENRIG = {
  url: env("OPENRIG_URL"),
  port: env("OPENRIG_PORT"),
  host: env("OPENRIG_HOST") || "127.0.0.1",
  token: env("OPENRIG_ACTIVITY_HOOK_TOKEN"),
  home: env("OPENRIG_HOME"),
  session: env("OPENRIG_SESSION_NAME") || "",
  nodeId: env("OPENRIG_NODE_ID") || "",
  runtime: env("OPENRIG_RUNTIME") || "dsh",
  generation: env("OPENRIG_OCCUPANT_GENERATION") || "",
  record: env("OPENRIG_LAUNCH_RESULT"),
  attempt: env("OPENRIG_LAUNCH_ATTEMPT") || "",
  resumeRef: env("OPENRIG_RESUME_REF"),
  firstInput: env("OPENRIG_FIRST_INPUT"),
  model: env("OPENRIG_MODEL"),
};
const argv = process.argv.slice(2);
const argValue = (name, fallback = null) => {
  const i = argv.indexOf(name);
  return i >= 0 && i + 1 < argv.length ? argv[i + 1] : fallback;
};
const agentCommand = argValue("--agent-command", "dsh --profile acp");
const presetName = argValue("--name", OPENRIG.runtime);

function env(name) {
  const value = process.env[name];
  return typeof value === "string" && value.trim() ? value.trim() : undefined;
}

// ── pane output ─────────────────────────────────────────────────────────────
// tmux keeps the pane alive for a person and for `rig capture`; stdout/stderr
// both land there. Never let a closed pane crash the runner with EPIPE.
const out = process.stdout;
for (const stream of [process.stdout, process.stderr]) stream.on("error", () => {});
let midLine = false;
function pane(text) {
  if (!text) return;
  out.write(text);
  midLine = !String(text).endsWith("\n");
}
function line(text = "") {
  if (midLine) { out.write("\n"); midLine = false; }
  out.write(`${text}\n`);
}
function warn(text) { line(`[dsh-seat] ${text}`); }

// ── launch record (contract §3) ─────────────────────────────────────────────
function writeLaunch(record) {
  if (!OPENRIG.record) return;
  try {
    mkdirSync(dirname(OPENRIG.record), { recursive: true });
    const tmp = `${OPENRIG.record}.tmp.${process.pid}`;
    writeFileSync(tmp, `${JSON.stringify(record)}\n`, { mode: 0o600 });
    renameSync(tmp, OPENRIG.record);
  } catch (error) {
    warn(`launch record not written: ${error.message}`);
  }
}
function producer() {
  return `dsh-seat ${VERSION}; dsh ${DSH_VERSION}; ACP ${PROTOCOL_VERSION}`;
}
function recordConversation(nativeRef) {
  writeLaunch({ format: 1, attempt: OPENRIG.attempt, harness: presetName, nativeRef, producer: producer() });
}
function recordMissing() {
  writeLaunch({ format: 1, attempt: OPENRIG.attempt, harness: presetName, error: "missing", producer: producer() });
}

// ── activity (contract §4) ──────────────────────────────────────────────────
// Posts are queued: each one is sent after the previous, in order, and never
// awaited by the agent/turn path. A refused or failed post records nothing.
let sequence = 0;
let postChain = Promise.resolve();
let endpoint = null;
function resolveEndpoint() {
  if (OPENRIG.url) return { base: OPENRIG.url.replace(/\/$/, ""), token: OPENRIG.token };
  if (OPENRIG.port) return { base: `http://${OPENRIG.host}:${OPENRIG.port}`, token: OPENRIG.token };
  if (OPENRIG.home) {
    try {
      const file = JSON.parse(readFileSync(join(OPENRIG.home, "activity-endpoint.json"), "utf8"));
      const base = file.url ?? file.baseUrl;
      if (base) return { base: String(base).replace(/\/$/, ""), token: file.token ?? OPENRIG.token };
    } catch { /* no endpoint file */ }
  }
  return null;
}
endpoint = resolveEndpoint();
function post(hookEvent, subtype, extra = {}) {
  if (!endpoint?.token) return postChain;
  const body = {
    sessionName: OPENRIG.session,
    nodeId: OPENRIG.nodeId,
    runtime: presetName,
    generation: OPENRIG.generation,
    sequence: ++sequence,
    occurredAt: new Date().toISOString(),
    hookEvent,
    subtype,
    ...extra,
  };
  postChain = postChain.then(async () => {
    try {
      await fetch(`${endpoint.base}/api/activity/hooks`, {
        method: "POST",
        headers: { "content-type": "application/json", authorization: `Bearer ${endpoint.token}` },
        body: JSON.stringify(body),
        signal: AbortSignal.timeout(1500),
      });
    } catch { /* never hold the runner on a post */ }
  });
  return postChain;
}
async function drainPosts(ms = 2000) {
  let timer;
  await Promise.race([
    postChain.catch(() => {}),
    new Promise((resolve) => { timer = setTimeout(resolve, ms); }),
  ]);
  clearTimeout(timer);
}

// ── ACP client ──────────────────────────────────────────────────────────────
let child = null;
let childExited = false;
let childExit = { code: null, signal: null };
let shuttingDown = false;
let writeBroken = false;
const pending = new Map();
let nextRequestId = 1;

function send(message) {
  if (!child?.stdin?.writable || writeBroken) return false;
  try {
    child.stdin.write(`${JSON.stringify(message)}\n`);
    return true;
  } catch {
    writeBroken = true;
    return false;
  }
}
function request(method, params, { timeoutMs = 0 } = {}) {
  const id = nextRequestId++;
  return new Promise((resolve, reject) => {
    if (childExited) { reject(new AcpError(`${method}: the agent is not running`, { code: null, method })); return; }
    const timer = timeoutMs > 0 ? setTimeout(() => {
      if (!pending.has(id)) return;
      pending.delete(id);
      reject(new AcpError(`${method}: timed out after ${timeoutMs}ms`, { code: null, method }));
    }, timeoutMs) : null;
    pending.set(id, { resolve, reject, method, timer });
    if (!send({ jsonrpc: "2.0", id, method, params })) {
      pending.delete(id);
      if (timer) clearTimeout(timer);
      reject(new AcpError(`${method}: could not write to the agent`, { code: null, method }));
    }
  });
}
class AcpError extends Error {
  constructor(message, { code = null, method = null } = {}) {
    super(message);
    this.name = "AcpError";
    this.code = code;
    this.method = method;
  }
}

function startAgent() {
  child = spawn(agentCommand, {
    shell: true,
    detached: process.platform !== "win32",
    stdio: ["pipe", "pipe", "pipe"],
    // The agent's shell must not inherit the activity hook token or the rest of
    // OpenRig's environment: baseline + DSH_HOME (+ the declared provider key).
    env: buildAgentEnv(process.env, { model: OPENRIG.model }),
  });
  child.on("error", (error) => {
    warn(`could not start the agent: ${error.message}`);
    void stop(1, "spawn-error");
  });
  child.on("exit", (code, signal) => {
    childExited = true;
    childExit = { code, signal };
    for (const [, entry] of pending) {
      if (entry.timer) clearTimeout(entry.timer);
      entry.reject(new AcpError(`agent exited (code=${code} signal=${signal})`, { method: entry.method }));
    }
    pending.clear();
    if (!shuttingDown) {
      warn(`agent exited (code=${code} signal=${signal})`);
      post("Stop", `${presetName}_exited`);
      void drainPosts().then(() => stop(code === 0 ? 0 : 1, "agent-exit"));
    }
  });
  let buffer = "";
  child.stdout.setEncoding("utf8");
  child.stdout.on("data", (chunk) => {
    buffer += chunk;
    let at;
    while ((at = buffer.indexOf("\n")) >= 0) {
      const raw = buffer.slice(0, at).replace(/\r$/, "");
      buffer = buffer.slice(at + 1);
      if (raw.trim()) handleAgentLine(raw);
    }
  });
  child.stderr.setEncoding("utf8");
  child.stderr.on("data", (chunk) => {
    for (const text of String(chunk).split("\n")) if (text.trim()) warn(text.trim());
  });
}

function handleAgentLine(raw) {
  let msg;
  try { msg = JSON.parse(raw); } catch {
    warn(`agent wrote a non-JSON line: ${raw.slice(0, 160)}`);
    return;
  }
  if (msg.id !== undefined && msg.method === undefined) {
    const entry = pending.get(msg.id);
    if (!entry) return;
    pending.delete(msg.id);
    if (entry.timer) clearTimeout(entry.timer);
    if (msg.error) entry.reject(new AcpError(msg.error.message ?? "ACP error", { code: msg.error.code ?? null, method: entry.method }));
    else entry.resolve(msg.result ?? null);
    return;
  }
  if (msg.method && msg.id !== undefined) { handleAgentRequest(msg); return; }
  if (msg.method) { handleAgentNotification(msg); return; }
}

function handleAgentRequest(msg) {
  if (msg.method === "session/request_permission") {
    const tool = msg.params?.toolCall ?? {};
    const title = tool.title ?? tool.toolCallId ?? "a tool";
    line(`[permission] ${title} — refused (first-version runner)`);
    attentionHeld = true;
    post("Notification", "permission_prompt");
    send({ jsonrpc: "2.0", id: msg.id, result: { outcome: { outcome: "cancelled" } } });
    return;
  }
  send({ jsonrpc: "2.0", id: msg.id, error: { code: -32601, message: `Method not found: ${msg.method}` } });
}

function handleAgentNotification(msg) {
  if (msg.method !== "session/update") return;
  const update = msg.params?.update ?? {};
  const kind = update.sessionUpdate;
  if (kind === "agent_message_chunk") {
    const content = update.content;
    if (content?.type === "text" && typeof content.text === "string") pane(content.text);
  } else if (kind === "agent_thought_chunk") {
    const content = update.content;
    if (content?.type === "text" && typeof content.text === "string") pane(content.text);
  } else if (kind === "tool_call" || kind === "tool_call_update") {
    const title = update.title ?? update.toolCallId ?? update.kind;
    if (title) line(`[tool] ${title}${update.status ? ` — ${update.status}` : ""}`);
  }
}

// ── input (contract §5) ─────────────────────────────────────────────────────
// Raw mode + bracketed paste. A whole paste (newlines included) plus the Enter
// that follows is one block. Only a block that is exactly "/abort", or Ctrl-C
// outside a paste, is control. Non-TTY input is read line by line.
let block = "";
let pasteBuffer = null;
let escapeBuffer = "";
let attentionHeld = false;
let promptQueued = false;
let currentTurn = null;
let turnCount = 0;
const queue = [];

function handleInputChunk(chunk) {
  for (const char of String(chunk)) {
    if (pasteBuffer !== null) {
      // Ctrl-C inside a paste is control too (listed in limits): abort the turn
      // and discard the paste rather than pasting the byte as text.
      if (char === "\x03") { pasteBuffer = null; block = ""; cancelTurn(); continue; }
      pasteBuffer += char;
      if (pasteBuffer.endsWith("\x1b[201~")) {
        block += pasteBuffer.slice(0, -6);
        pasteBuffer = null;
      }
      continue;
    }
    if (escapeBuffer) {
      escapeBuffer += char;
      if (escapeBuffer === "\x1b[200~") { pasteBuffer = ""; escapeBuffer = ""; continue; }
      if ("\x1b[200~".startsWith(escapeBuffer) || "\x1b[201~".startsWith(escapeBuffer)) continue;
      escapeBuffer = "";
      continue;
    }
    if (char === "\x1b") { escapeBuffer = "\x1b"; continue; }
    if (char === "\r" || char === "\n") { submitBlock(); continue; }
    if (char === "\x03") {
      if (pasteBuffer !== null) { pasteBuffer = null; block = ""; }
      cancelTurn();
      continue;
    }
    if (char === "\x7f" || char === "\b") { block = block.slice(0, -1); continue; }
    block += char;
  }
}

function submitBlock() {
  const value = block;
  block = "";
  if (!value.trim()) return;
  if (value === "/abort") { cancelTurn(); return; }
  if (!sessionId) { warn("no conversation is open yet — the prompt was not sent"); return; }
  queue.push(value);
  if (queue.length > 1 || currentTurn) {
    line(`[queued: ${queue.length}${currentTurn ? " · 1 running" : ""}]`);
  } else {
    void pump();
  }
}

function cancelTurn() {
  if (!sessionId || !currentTurn) { line("[dsh-seat] cancel requested (no turn in flight)"); return; }
  if (currentTurn.cancelSent) return;
  currentTurn.cancelSent = true;
  send({ jsonrpc: "2.0", method: "session/cancel", params: { sessionId } });
  line("[dsh-seat] cancel requested");
}

async function pump() {
  if (promptQueued || !sessionId || shuttingDown) return;
  const text = queue.shift();
  if (text === undefined) return;
  promptQueued = true;
  attentionHeld = false;
  const turn = { cancelSent: false };
  currentTurn = turn;
  const turnId = String(++turnCount);
  post("UserPromptSubmit", "accepted", { turnId });
  line(`you ▸ ${text.split("\n")[0].slice(0, 160)}${text.includes("\n") ? " …" : ""}`);
  try {
    const result = await request("session/prompt", { sessionId, prompt: [{ type: "text", text }] });
    const stopReason = typeof result?.stopReason === "string" ? result.stopReason : "end_turn";
    if (!attentionHeld) post("Stop", stopReason, { livenessSeconds: 30 });
  } catch (error) {
    if (!childExited && !shuttingDown) {
      warn(`prompt failed: ${error.message}`);
      post("Notification", "runtime_error");
    }
  } finally {
    promptQueued = false;
    currentTurn = null;
    if (!shuttingDown) void pump();
  }
}

// ── handshake and resume (contract §3, §8) ──────────────────────────────────
let sessionId = null;

async function openConversation() {
  const init = await request("initialize", {
    protocolVersion: PROTOCOL_VERSION,
    clientCapabilities: {},
    clientInfo: { name: "dsh-seat", version: VERSION },
  }, { timeoutMs: 30000 });
  if (init?.protocolVersion !== PROTOCOL_VERSION) {
    throw new Error(`the agent speaks ACP ${init?.protocolVersion ?? "unknown"}; this runner needs ACP ${PROTOCOL_VERSION}`);
  }
  if (OPENRIG.resumeRef) {
    await reopen(OPENRIG.resumeRef);
  } else {
    const result = await request("session/new", { cwd: process.cwd(), mcpServers: [] }, { timeoutMs: 30000 });
    sessionId = typeof result?.sessionId === "string" ? result.sessionId : "";
    if (!sessionId) throw new Error("session/new returned no session id");
    // Apply the model before the launch record: OpenRig may consider the seat
    // ready as soon as the record exists, so the declared model must already be
    // in effect (or reported as unappliable) by then.
    await applyModel(result?.configOptions);
    recordConversation(sessionId);
  }
}

async function reopen(ref) {
  const params = { sessionId: ref, cwd: process.cwd(), mcpServers: [] };
  let result;
  try {
    result = await request("session/resume", params, { timeoutMs: 30000 });
  } catch (error) {
    // ACP's loadSession is the alternative reopen method some agents advertise.
    // dsh 0.2.1-rc.2 advertises sessionCapabilities.resume only and answers
    // session/load with -32601; this fallback is for other ACP agents.
    if (error.code === -32601 || /method not found/i.test(error.message)) {
      result = await request("session/load", params, { timeoutMs: 30000 });
    } else if (isMissing(error)) {
      recordMissing();
      await drainPosts();
      await stop(0, "resume-missing");
      throw error;
    } else {
      warn(`resume failed: ${error.message}`);
      await drainPosts();
      await stop(1, "resume-failed");
      throw error;
    }
  }
  // dsh's session/resume does not re-report the id; an error-free reopen is the
  // contract's "same conversation reopened" and the requested ref is recorded.
  sessionId = ref;
  // A changed model on restore must apply too, from the resume's configOptions,
  // before the record makes the seat ready.
  await applyModel(result?.configOptions);
  recordConversation(ref);
}

function isMissing(error) {
  return error?.code === -32002
    // dsh 0.2.1-rc.2 says "session is not resumable: <id>" for an unknown id and
    // "session is already active: <id>" for a live one — only the former is its
    // own word that the conversation is gone.
    || /session not found|not found|no such session|unknown session|session is not resumable/i.test(String(error?.message ?? ""));
}

async function applyModel(configOptions) {
  if (!OPENRIG.model) return;
  const resolved = resolveModelChoice(configOptions, OPENRIG.model);
  if (!resolved.ok) {
    // Reported, never silently ignored: the pane says what was asked and what
    // dsh advertised; dsh's own default stays in effect.
    warn(`declared model ${OPENRIG.model} not applied: ${resolved.error}`);
    return;
  }
  try {
    await request("session/set_config_option", { sessionId, configId: "model", value: resolved.value }, { timeoutMs: 15000 });
    line(`[dsh-seat] model: ${resolved.label}`);
  } catch (error) {
    warn(`could not apply the declared model: ${error.message}`);
  }
}

function enqueueFirstInput() {
  if (!OPENRIG.firstInput) return;
  try {
    const text = readFileSync(OPENRIG.firstInput, "utf8");
    if (text.length > 0 && sessionId) { queue.push(text); void pump(); }
  } catch (error) {
    warn(`could not read OPENRIG_FIRST_INPUT: ${error.message}`);
  }
}

// ── lifecycle ───────────────────────────────────────────────────────────────
let ttyRestored = false;
function restoreTty() {
  if (ttyRestored) return;
  ttyRestored = true;
  try { process.stdin.setRawMode?.(false); } catch { /* not a tty */ }
  try { out.write("\x1b[?2004l"); } catch { /* pane gone */ }
}
function killAgent(signal) {
  if (!child?.pid) return;
  try { process.kill(-child.pid, signal); } catch {
    try { child.kill(signal); } catch { /* already gone */ }
  }
}
async function stop(code, why) {
  if (shuttingDown) return;
  shuttingDown = true;
  restoreTty();
  warn(`shutting down (${why})`);
  killAgent("SIGTERM");
  const exited = new Promise((resolve) => {
    if (childExited) { resolve(); return; }
    child?.once("exit", resolve);
  });
  await Promise.race([exited, new Promise((resolve) => setTimeout(resolve, 1200))]);
  killAgent("SIGKILL");
  await drainPosts();
  process.exit(code);
}

async function main() {
  startAgent();
  if (process.stdin.isTTY) {
    process.stdin.setRawMode(true);
    out.write("\x1b[?2004h");
  }
  process.stdin.setEncoding("utf8");
  if (process.stdin.isTTY) {
    process.stdin.on("data", handleInputChunk);
  } else {
    let buffer = "";
    process.stdin.on("data", (chunk) => {
      buffer += chunk;
      let at;
      while ((at = buffer.indexOf("\n")) >= 0) {
        const text = buffer.slice(0, at).replace(/\r$/, "");
        buffer = buffer.slice(at + 1);
        if (text.trim() && text !== "/abort") { queue.push(text); void pump(); }
        else if (text === "/abort") cancelTurn();
      }
    });
  }
  process.stdin.on("close", () => { if (!shuttingDown) void stop(0, "stdin-closed"); });
  process.on("SIGHUP", () => void stop(0, "hangup"));
  process.on("SIGTERM", () => void stop(0, "sigterm"));
  process.on("SIGINT", () => void stop(0, "sigint"));
  process.on("exit", () => killAgent("SIGKILL"));

  try {
    await openConversation();
    line(`[dsh-seat] ${presetName} ready · ACP ${PROTOCOL_VERSION}`);
    enqueueFirstInput();
  } catch (error) {
    if (!shuttingDown) {
      warn(`handshake failed: ${error.message}`);
      await stop(1, "handshake-failed");
    }
  }
}

void main();
